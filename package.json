{
  "name": "solveguide-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/desktop.ps1",
    "desktop:check": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/desktop.ps1 -Check",
    "setup:rust": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup-rust.ps1",
    "lint": "eslint . --max-warnings 0",
    "test:interaction": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.0.0"
  }
}
