# Backend-only configuration. Never place credentials in VITE_* variables.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
VISION_TIMEOUT_SECONDS=45
VISION_MAX_OUTPUT_TOKENS=4096

# Independent, text-only answer provider
OPENAI_ANSWER_MODEL=gpt-5.4
ANSWER_TIMEOUT_SECONDS=60
ANSWER_MAX_OUTPUT_TOKENS=6000
ANSWER_REASONING_EFFORT=medium

# Milestone 6 — backend only. Blank values keep local AI tools available without auth.
# Use the direct Neon connection URL for Alembic, TLS verify-full recommended.
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate locally with cryptography.fernet.Fernet.generate_key(); never commit it.
AUTH_STATE_ENCRYPTION_KEY=
AUTH_PUBLIC_BASE_URL=http://127.0.0.1:8000
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=168
