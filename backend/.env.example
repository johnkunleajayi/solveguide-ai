# Backend-only configuration. Never place credentials in VITE_* variables.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
VISION_TIMEOUT_SECONDS=45
VISION_MAX_OUTPUT_TOKENS=4096

# Independent, text-only answer provider
OPENAI_ANSWER_MODEL=gpt-5.4
ANSWER_TIMEOUT_SECONDS=60
ANSWER_MAX_OUTPUT_TOKENS=6000
ANSWER_REASONING_EFFORT=medium
