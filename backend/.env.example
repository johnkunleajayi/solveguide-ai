# Backend-only configuration. Never place credentials in VITE_* variables.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
VISION_TIMEOUT_SECONDS=45
VISION_MAX_OUTPUT_TOKENS=4096

# Independent, text-only answer provider
OPENAI_ANSWER_MODEL=gpt-5.4
ANSWER_TIMEOUT_SECONDS=60
ANSWER_MAX_OUTPUT_TOKENS=6000
ANSWER_REASONING_EFFORT=medium

# Backend only. Authentication is mandatory for library and learning workflows.
# Use the direct Neon connection URL for Alembic, TLS verify-full recommended.
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate locally with cryptography.fernet.Fernet.generate_key(); never commit it.
AUTH_STATE_ENCRYPTION_KEY=
AUTH_PUBLIC_BASE_URL=http://127.0.0.1:8000
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=168

# Context Library: originals in .cache/context-library by default; never a public mount.
CONTEXT_UPLOAD_BYTES=10485760
CONTEXT_TEXT_CHARACTERS=500000
CONTEXT_MAX_PAGES=200
CONTEXT_MAX_BLOCKS=5000
CONTEXT_EXPANDED_BYTES=33554432
# Optional backend-only absolute private storage directory (keep development on D:).
# CONTEXT_STORAGE_DIRECTORY=D:/solveguide-ai/.cache/context-library

# Explicit Context Library indexing / RAG (backend only)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=512
EMBEDDING_TIMEOUT_SECONDS=25
RAG_CHUNK_CHARACTERS=1000
RAG_TOP_K=6
RAG_CONTEXT_TOKENS=6000
RAG_SEMANTIC_THRESHOLD=0.3
