{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SolveGuide AI",
  "version": "0.1.0",
  "identifier": "com.solveguide.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SolveGuide AI",
        "width": 1320,
        "height": 900,
        "minWidth": 640,
        "minHeight": 560,
        "center": true,
        "create": false
      }
    ],
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8000"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
